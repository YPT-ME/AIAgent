# =============================================================================
# RAG AI Agent - Development Dockerfile
# =============================================================================
# Optimized for development with hot-reload support

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Copy application code (will be overridden by volume mount)
COPY ./src ./src
COPY ./langgraph.json ./langgraph.json
COPY ./system_prompt.txt ./system_prompt.txt
COPY ./system_prompt.example.txt ./system_prompt.example.txt

# Create storage directories
RUN mkdir -p /app/storage/faiss /app/data/pdfs

# Copy and setup entrypoint script
COPY ./entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Expose LangGraph Server port
EXPOSE 2024

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:2024/health || exit 1

# Use entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]

# Run LangGraph Server in development mode (with auto-reload)
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "2024"]
