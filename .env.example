# =============================================================================
# RAG AI Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real secrets!
# This is the ONLY .env file needed for the entire project

# =============================================================================
# 🔑 REQUIRED - Core API Keys (Must Configure First)
# =============================================================================

# OpenAI API Key - REQUIRED for AI functionality
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangGraph API Key - REQUIRED for authentication (Min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LANGGRAPH_API_KEY=your-secret-api-key-min-32-chars-here

# =============================================================================
# 🌐 Frontend Configuration (Important)
# =============================================================================

# Backend API connection
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=rag_agent
NEXT_PUBLIC_API_KEY=your-secret-api-key-min-32-chars-here

# UI Branding & Messages
NEXT_PUBLIC_AGENT_NAME=Agent Chat
NEXT_PUBLIC_WELCOME_MESSAGE=Welcome! Ask me anything about the documentation.

# =============================================================================
# ⚙️ Basic Configuration (Good Defaults)
# =============================================================================

# AI Model Selection
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Settings
TOP_K=5

# =============================================================================
# 🔧 Advanced Configuration (Optional - Modify if needed)
# =============================================================================

# Storage Paths
FAISS_INDEX_PATH=./backend/storage/faiss
MANIFEST_PATH=./backend/storage/manifest.json
DOCS_DIR=./data/docs
PDF_DIR=./data/pdfs

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_LENGTH=5000
MAX_THREADS_PER_USER=20

# Logging
LOG_LEVEL=INFO

# UI Feature Toggles (set to "false" to hide/disable)
NEXT_PUBLIC_SHOW_TOOL_CALLS_TOGGLE=true
NEXT_PUBLIC_SHOW_FILE_UPLOAD=true

# Optional: LangSmith for debugging (leave empty if not using)
LANGSMITH_API_KEY=
